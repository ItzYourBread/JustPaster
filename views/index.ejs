<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Create Paste - JustPaster</title>
  <link rel="stylesheet" href="/style.css" />
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>

<body>
  <div class="container">
    <h1>Create a New Paste</h1>
    <form id="createPasteForm">
      <textarea name="content" rows="24" placeholder="Write your markdown here..." required></textarea>
      <button type="submit">Create Paste</button>
    </form>
  </div>

  <script>
    $(document).ready(function () {
      $('#createPasteForm').on('submit', function (event) {
        event.preventDefault();

        const content = $("textarea[name='content']").val();

        $.ajax({
          url: '/api/paste',
          type: 'POST',
          contentType: 'application/json',
          data: JSON.stringify({ content }),
          success: function (response) {
            window.location.href = `/${response.id}`;
          },
          error: function () {
            alert("An error occurred while creating the paste.");
          }
        });
      });
    });
  </script>
</body>

</html>
