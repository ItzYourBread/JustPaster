<!DOCTYPE html>
<html>

<head>
  <title>JustPaster - Create Paste</title>
  <link rel="stylesheet" type="text/css" href="/style.css">
  <link rel="icon" type="image/png" href="/justpaster.png">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<body>
  <div class="container">
    <header>
      <h1>JustPaster</h1>
    </header>
    <main>
      <form action="/" method="POST">
        <textarea name="content" rows="20" placeholder="Write your markdown here..."></textarea>
        <button type="submit">Create Paste</button>
      </form>
    </main>
    <footer>
      <p>&copy; 2024 JustPaster. All rights reserved.</p>
    </footer>
  </div>
</body>

</html>
