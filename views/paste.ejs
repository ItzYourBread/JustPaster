<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#101713">
  <meta name="robots" content="noindex, follow">
  <link rel="canonical" href="<%= siteUrl %>/<%= encodeURIComponent(paste._id) %>">
  <title>Shared paste <%= paste._id %> | JustPaster</title>
  <meta name="description" content="A text paste shared with JustPaster. Create and share text, code, and notes with a simple link.">
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="JustPaster">
  <meta property="og:url" content="<%= siteUrl %>/<%= encodeURIComponent(paste._id) %>">
  <meta property="og:title" content="Shared paste | JustPaster">
  <meta property="og:description" content="A text paste shared with JustPaster.">
  <meta property="og:image" content="<%= siteUrl %>/logo-w1200.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="437">
  <meta property="og:image:alt" content="JustPaster">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Shared paste | JustPaster">
  <meta name="twitter:description" content="A text paste shared with JustPaster.">
  <meta name="twitter:image" content="<%= siteUrl %>/logo-w1200.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="shortcut icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="stylesheet" href="/style.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
</head>

<body>
  <main class="main-wrapper paste-wrapper">
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="JustPaster home">
        <img class="logo-image" src="/logo-w800.png" srcset="/logo-w400.png 400w, /logo-w800.png 800w, /logo-w1200.png 1200w, /logo-w2400.png 2400w" sizes="(max-width: 640px) 58vw, 224px" alt="JustPaster" width="400" height="146" fetchpriority="high">
      </a>
      <a class="back-link" href="/">&#8592; New paste</a>
    </header>

    <section class="paste-shell" aria-labelledby="paste-title">
      <div class="paste-heading">
        <div>
          <p class="eyebrow">SHARED PASTE</p>
          <h1 id="paste-title"><%= paste._id %></h1>
        </div>
        <div class="paste-views"><span class="status-dot"></span><%= paste.views.toLocaleString() %> views</div>
      </div>

      <pre class="viewer-content"><code><%= paste.content %></code></pre>

      <div class="actions" aria-label="Paste actions">
        <button class="btn btn-secondary" id="copyContentBtn" type="button">Copy text</button>
        <button class="btn btn-secondary" id="copyLinkBtn" type="button">Copy link</button>
        <button class="btn btn-secondary" id="qrBtn" type="button">Share QR</button>
        <% if (canEdit) { %>
        <button class="btn btn-secondary" id="editPasteBtn" type="button" aria-expanded="false" aria-controls="editPastePanel">Edit paste</button>
        <% } %>
      </div>
      <% if (canEdit) { %>
      <form class="paste-edit-panel" id="editPastePanel" hidden>
        <label class="field-label" for="editContent">Updated text</label>
        <textarea id="editContent" maxlength="1048576" required spellcheck="false"><%= paste.content %></textarea>
        <label class="field-label" for="editPermissionCode">Edit permission code</label>
        <input class="link-input" id="editPermissionCode" type="password" minlength="8" maxlength="128" autocomplete="current-password" required>
        <div class="editor-footer">
          <p class="form-message" id="editMessage" role="status" aria-live="polite"></p>
          <button class="btn btn-primary" type="submit" id="saveEditBtn">Save changes</button>
        </div>
      </form>
      <% } %>
    </section>

    <footer class="site-footer"><span>JustPaster</span><span>Text, shared simply.</span></footer>
  </main>

  <div class="qr-modal" id="qrModal" role="dialog" aria-modal="true" aria-labelledby="qrTitle" hidden>
    <div class="qr-box">
      <button class="qr-close" id="qrClose" type="button" aria-label="Close QR code">&times;</button>
      <h2 id="qrTitle">Scan to open this paste</h2>
      <div id="qrcode"></div>
    </div>
  </div>

  <p id="toast" class="toast" role="status" aria-live="polite"></p>

  <script>
    const qrModal = document.getElementById('qrModal');
    const qrDiv = document.getElementById('qrcode');

    function showToast(message) {
      const toast = document.getElementById('toast');
      toast.textContent = message;
      toast.classList.add('visible');
      window.setTimeout(() => toast.classList.remove('visible'), 2200);
    }

    async function copyText(text, label) {
      try {
        await navigator.clipboard.writeText(text);
        showToast(`${label} copied`);
      } catch {
        showToast('Clipboard access is unavailable in this browser');
      }
    }

    document.getElementById('copyContentBtn').addEventListener('click', () => {
      copyText(document.querySelector('.viewer-content code').textContent, 'Paste text');
    });
    document.getElementById('copyLinkBtn').addEventListener('click', () => {
      copyText(window.location.href, 'Link');
    });
    const editPasteBtn = document.getElementById('editPasteBtn');
    if (editPasteBtn) {
      const editPastePanel = document.getElementById('editPastePanel');
      const editContent = document.getElementById('editContent');
      const editPermissionCode = document.getElementById('editPermissionCode');
      const editMessage = document.getElementById('editMessage');

      editPasteBtn.addEventListener('click', () => {
        editPastePanel.hidden = !editPastePanel.hidden;
        editPasteBtn.setAttribute('aria-expanded', String(!editPastePanel.hidden));
        if (!editPastePanel.hidden) editPermissionCode.focus();
      });

      editPastePanel.addEventListener('submit', async (event) => {
        event.preventDefault();
        const saveButton = document.getElementById('saveEditBtn');
        saveButton.disabled = true;
        editMessage.textContent = '';
        try {
          const response = await fetch(`/api/paste/${encodeURIComponent('<%= paste._id %>')}/edit`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: editContent.value, editCode: editPermissionCode.value })
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Unable to update paste.');
          document.querySelector('.viewer-content code').textContent = editContent.value;
          editPermissionCode.value = '';
          editPastePanel.hidden = true;
          editPasteBtn.setAttribute('aria-expanded', 'false');
          showToast('Paste updated');
        } catch (error) {
          editMessage.textContent = error.message;
        } finally {
          saveButton.disabled = false;
        }
      });
    }
    document.getElementById('qrBtn').addEventListener('click', () => {
      qrDiv.replaceChildren();
      new QRCode(qrDiv, {
        text: window.location.href,
        width: 176,
        height: 176,
        colorDark: '#101713',
        colorLight: '#ffffff'
      });
      qrModal.hidden = false;
      document.getElementById('qrClose').focus();
    });

    function closeQrModal() {
      qrModal.hidden = true;
      document.getElementById('qrBtn').focus();
    }
    document.getElementById('qrClose').addEventListener('click', closeQrModal);
    qrModal.addEventListener('click', (event) => {
      if (event.target === qrModal) closeQrModal();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !qrModal.hidden) closeQrModal();
    });
  </script>
</body>
</html>